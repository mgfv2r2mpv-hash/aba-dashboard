{
  "name": "aba-dashboard",
  "version": "1.1.0",
  "type": "module",
  "description": "A dashboard to quickly manage supervision and scheduling, using claude API to accept changes to schedule and come up with alternatives for the user to ensure clinical compliance according to configurable company and credentialing requirements.",
  "main": "index.js",
  "scripts": {
    "build": "tsc && vite build",
    "build:server": "tsc",
    "build:client": "vite build",
    "cap:ios": "npx capacitor-assets generate --ios && npm run build:client && npx cap copy ios && node scripts/patch-ios-plist.cjs",
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "dev:client": "vite"
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:39143/git/mgfv2r2mpv-hash/aba-dashboard"
  },
