{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedSideEffectImports": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../src/*"],
      "@anthropic-ai/sdk": ["./node_modules/@anthropic-ai/sdk"],
      "@capacitor/core": ["./src/stubs/capacitorCore"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "uuid": ["./node_modules/uuid"],
      "date-fns": ["./node_modules/date-fns"],
      "xlsx": ["./node_modules/xlsx"]
    }
  },
  // `functions` is in here on purpose: the Pages Functions bundler is the only
  // other thing that compiles this directory, and it does so at deploy time, where
  // a failure is silent until the site is already down.
  //
  // Nothing that is not a Function may live under `functions`. Cloudflare compiles
  // EVERY file it finds there into the deployed Worker, so the tests sit in
  // ./functions-tests and import across. Putting one back here takes the deploy
  // down, which is how the login store's sqlite test broke the portal.
  "include": ["src", "functions"],
  // Tests import vitest, which the Pages build never installs. They are
  // typechecked by tsconfig.test.json instead - see npm run typecheck:test.
  "exclude": ["src/test", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
