{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedSideEffectImports": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../src/*"],
      "@anthropic-ai/sdk": ["./node_modules/@anthropic-ai/sdk"],
      "@capacitor/core": ["./src/stubs/capacitorCore"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "uuid": ["./node_modules/uuid"],
      "date-fns": ["./node_modules/date-fns"],
      "xlsx": ["./node_modules/xlsx"]
    }
  },
  // `functions` is in here on purpose: the Pages Functions bundler is the only
  // other thing that compiles this directory, and it does so at deploy time, where
  // a failure is silent until the site is already down.
  //
  // NO TEST FILE MAY SIT INSIDE A DIRECTORY NAMED HERE. Cloudflare builds this
  // project with the root directory set to `webportal`, so the only `npm install`
  // that runs is the one in here and there is no repo-root node_modules at all.
  // A test imports vitest, tsc resolves it by walking up to the root tree, and the
  // build dies. A laptop has that tree and CI has that tree, so both stay green
  // while every deploy fails, which is how it went unnoticed for three days. The
  // Function tests live in ./functions-tests and import across;
  // functions-tests/tsconfigSeam.test.ts fails if one lands back under `functions`.
  "include": ["src", "functions"],
  // The src tests predate that rule and stay where they are, excluded by name.
  // tsconfig.test.json is what typechecks them - see npm run typecheck:test.
  "exclude": ["src/test", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
